{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'approvals' %}
{% set crumbs = [{ label: 'Approvals'|t('forklift'), url: url('forklift/approvals') }] %}

{% block content %}
    <div class="pane">
        <table class="data fullwidth">
            <tbody>
                <tr><th class="thin">{{ 'Status'|t('app') }}</th><td>{{ approval.statusLabel }}</td></tr>
                <tr><th>{{ 'Company'|t('forklift') }}</th><td>{% if company %}<a href="{{ company.cpEditUrl }}">{{ company.uiLabel }}</a>{% endif %}</td></tr>
                <tr><th>{{ 'Buyer'|t('forklift') }}</th><td>{{ approval.requester ? approval.requester.name : '' }}</td></tr>
                <tr><th>{{ 'Amount when submitted'|t('forklift') }}</th><td>{{ approval.amount|number_format(2) }}</td></tr>
                {% if order %}
                    <tr>
                        <th>{{ 'Amount now'|t('forklift') }}</th>
                        <td>
                            {{ order.totalPrice|number_format(2) }}
                            {% if order.totalPrice > approval.amount %}
                                <span class="error">{{ 'The basket has grown since it was submitted.'|t('forklift') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr><th>{{ 'Order'|t('forklift') }}</th><td><a href="{{ order.cpEditUrl }}">{{ order.shortNumber }}</a></td></tr>
                {% endif %}
                <tr><th>{{ 'Why'|t('forklift') }}</th><td>{{ approval.reasonLabel }}</td></tr>
                {% if approval.note %}<tr><th>{{ 'Their note'|t('forklift') }}</th><td>{{ approval.note }}</td></tr>{% endif %}
                {% if approval.decisionNote %}<tr><th>{{ 'Decision note'|t('forklift') }}</th><td>{{ approval.decisionNote }}</td></tr>{% endif %}
                {% if approval.approver %}<tr><th>{{ 'Decided by'|t('forklift') }}</th><td>{{ approval.approver.name }}</td></tr>{% endif %}
            </tbody>
        </table>
    </div>

    {% if order and order.lineItems|length %}
        <div class="pane">
            <h2>{{ 'What was ordered'|t('forklift') }}</h2>
            <table class="data fullwidth">
                <thead><tr><th>{{ 'SKU'|t('forklift') }}</th><th>{{ 'Description'|t('app') }}</th><th>{{ 'Qty'|t('forklift') }}</th><th>{{ 'Each'|t('forklift') }}</th><th>{{ 'Total'|t('forklift') }}</th></tr></thead>
                <tbody>
                    {% for item in order.lineItems %}
                        <tr>
                            <td><code>{{ item.sku }}</code></td>
                            <td>{{ item.description }}</td>
                            <td>{{ item.qty }}</td>
                            <td>{{ item.salePrice|number_format(2) }}</td>
                            <td>{{ item.subtotal|number_format(2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if approval.isPending %}
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            <input type="hidden" name="action" value="forklift/approvals/decide">
            <input type="hidden" name="approvalId" value="{{ approval.id }}">
            {{ redirectInput('forklift/approvals') }}

            {{ forms.textareaField({
                label: 'Note'|t('forklift'),
                instructions: 'Sent to the buyer with the decision.'|t('forklift'),
                name: 'note',
                rows: 3,
            }) }}

            <button type="submit" name="decision" value="approve" class="btn submit">{{ 'Approve'|t('forklift') }}</button>
            <button type="submit" name="decision" value="decline" class="btn">{{ 'Decline'|t('forklift') }}</button>
        </form>
    {% endif %}
{% endblock %}
