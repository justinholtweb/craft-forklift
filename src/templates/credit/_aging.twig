{#
  The aging table.

  Shared by the control panel and the buyer's portal, so a customer disputing a figure and the
  person answering the telephone are looking at arithmetic that came from the same place.
#}
<table class="data fullwidth">
    <thead>
        <tr>
            {% for days, label in statement.agingLabels %}<th>{{ label }}</th>{% endfor %}
            <th>{{ 'Total'|t('forklift') }}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            {% for days, label in statement.agingLabels %}
                <td class="{{ days > 0 and (statement.aging[days] ?? 0) > 0 ? 'error' }}">
                    {{ (statement.aging[days] ?? 0)|number_format(2) }}
                </td>
            {% endfor %}
            <td><strong>{{ statement.closingBalance|number_format(2) }}</strong></td>
        </tr>
    </tbody>
</table>
