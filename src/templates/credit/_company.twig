{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'credit' %}
{% set crumbs = [
    { label: 'Credit'|t('forklift'), url: url('forklift/credit') },
    { label: company.uiLabel, url: company.cpEditUrl },
] %}

{% block actionButton %}
    <a class="btn" href="{{ url('forklift/companies/' ~ company.id ~ '/statement') }}">{{ 'Statement'|t('forklift') }}</a>
{% endblock %}

{% block content %}
    <div class="pane">
        <table class="data fullwidth">
            <tbody>
                <tr><th class="thin">{{ 'Terms'|t('forklift') }}</th><td>{{ company.terms ? company.terms.shorthand : 'Prepay'|t('forklift') }}</td></tr>
                <tr><th>{{ 'Credit limit'|t('forklift') }}</th><td>{{ company.creditLimit is null ? 'No limit'|t('forklift') : company.creditLimit|number_format(2) }}</td></tr>
                <tr><th>{{ 'Balance'|t('forklift') }}</th><td><strong>{{ statement.closingBalance|number_format(2) }}</strong></td></tr>
                <tr>
                    <th>{{ 'Available'|t('forklift') }}</th>
                    <td class="{{ statement.isOverLimit ? 'error' }}">
                        {{ statement.creditRemaining is null ? '—' : statement.creditRemaining|number_format(2) }}
                    </td>
                </tr>
                <tr><th>{{ 'Overdue'|t('forklift') }}</th><td>{{ statement.totalOverdue|number_format(2) }}</td></tr>
            </tbody>
        </table>
    </div>

    <div class="pane">
        <h2>{{ 'Aged'|t('forklift') }}</h2>
        {% include 'forklift/credit/_aging' %}
    </div>

    {% if currentUser.can('forklift:manageCredit') %}
        <div class="pane">
            <h2>{{ 'Record a payment'|t('forklift') }}</h2>
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="forklift/credit/record-payment">
                <input type="hidden" name="companyId" value="{{ company.id }}">
                {{ redirectInput('forklift/companies/' ~ company.id ~ '/credit') }}

                {{ forms.textField({ label: 'Amount received'|t('forklift'), type: 'number', step: '0.01', min: '0.01', name: 'amount', required: true }) }}
                {{ forms.textField({ label: 'Reference'|t('forklift'), name: 'reference', instructions: 'Cheque number, remittance advice, bank reference.'|t('forklift') }) }}
                {{ forms.dateField({ label: 'Date'|t('forklift'), name: 'entryDate' }) }}

                <button type="submit" class="btn submit">{{ 'Record payment'|t('forklift') }}</button>
            </form>
        </div>

        <div class="pane">
            <h2>{{ 'Adjustment'|t('forklift') }}</h2>
            <p class="light">{{ 'A credit note, a write-off, a correction. A negative amount reduces what they owe.'|t('forklift') }}</p>
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="forklift/credit/record-adjustment">
                <input type="hidden" name="companyId" value="{{ company.id }}">
                {{ redirectInput('forklift/companies/' ~ company.id ~ '/credit') }}

                {{ forms.textField({ label: 'Amount'|t('forklift'), type: 'number', step: '0.01', name: 'amount', required: true }) }}
                {{ forms.textareaField({ label: 'Note'|t('forklift'), name: 'note', rows: 2 }) }}
                {{ forms.dateField({ label: 'Date'|t('forklift'), name: 'entryDate' }) }}

                <button type="submit" class="btn submit">{{ 'Record adjustment'|t('forklift') }}</button>
            </form>
        </div>
    {% endif %}
{% endblock %}
